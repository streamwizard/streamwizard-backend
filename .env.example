# ============================================================
# StreamWizard — Environment Variables
# Copy this file to .env and fill in your values.
# Local Supabase values are shown by running: supabase start
# ============================================================

# General
NODE_ENV=development

# ── Supabase ─────────────────────────────────────────────────
# Local: http://127.0.0.1:54321 | Cloud: https://<project>.supabase.co
SUPABASE_URL=

# Anon/public key — safe to expose to the browser
# Local: printed by `supabase start` as "anon key"
SUPABASE_PUBLIC_KEY=

# Service role key — never expose this publicly
# Local: printed by `supabase start` as "service_role key"
SUPABASE_SECRET_KEY=

# ── Twitch ───────────────────────────────────────────────────
# Create an app at https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Random string used to verify incoming EventSub webhook payloads
TWITCH_WEBHOOK_SECRET=

SUPABASE_AUTH_EXTERNAL_TWITCH_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_TWITCH_SECRET=

# EventSub conduit ID — created once via the Twitch API and reused
TWITCH_CONDUIT_ID=

# ── Token Encryption ─────────────────────────────────────────
# 32-byte hex string used to encrypt Twitch OAuth tokens at rest
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ── Discord ───────────────────────────────────────────────────
# Create an app at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# Client secret (web app only) — used to refresh Discord OAuth tokens when
# revoking the Linked Role on disconnect.
DISCORD_CLIENT_SECRET=

# Guild ID for instant slash command propagation in dev. Omit in staging/production.
DISCORD_GUILD_ID=

# Discord user ID that receives EventSub outage/recovery DMs from the bot
# (streamwizard-bot only). Leave empty to disable alert DMs.
DISCORD_ALERT_USER_ID=

# ── Internal Service URLs ────────────────────────────────────
# WebSocket server base URL (e.g. ws://localhost:8000 locally)
WS_SERVER_URL=

# REST API base URL (e.g. http://localhost:3001 locally)
STREAMWIZARD_API_URL=

# ── Next.js Public URLs (web-streamwizard + web-overlay) ─────
# Publicly accessible base URL of the main dashboard
NEXT_PUBLIC_BASE_URL=

# Publicly accessible base URL of the overlay app
NEXT_PUBLIC_OVERLAY_URL=

# ── Cloudflare R2 user assets (web-streamwizard) ─────────────
# S3-compatible credentials for the media-library bucket (streamer-uploaded
# alert images/sounds/videos). Optional: media library is disabled when unset.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ASSETS_BUCKET=
# Public domain serving that bucket. Optional: falls back to NEXT_PUBLIC_CDN_URL
# (user assets share the static-CDN bucket under the assets/ prefix).
NEXT_PUBLIC_ASSET_CDN_URL=

# ── InfluxDB (web-admin only) ───────────────────────────────
# One InfluxDB instance shared across environments, one bucket per env:
# streamwizard-dev / streamwizard-staging / streamwizard-prod. Set BUCKET to
# match the environment this Doppler config is for.
INFLUXDB_URL=
INFLUXDB_TOKEN=
INFLUXDB_ORG=
INFLUXDB_BUCKET=

# ── Monitor (optional) ───────────────────────────────────────
# Shared secret to protect the live WebSocket inspector
MONITOR_SECRET=

# ── Sentry (optional) ────────────────────────────────────────
SENTRY_DSN=
SENTRY_RELEASE=

# ── PostHog (optional) ───────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
